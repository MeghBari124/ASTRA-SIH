# ─────────────────────────────────────────────────────────────────
# ASTRA Safety Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────────

# Application identity
PROJECT_NAME="ASTRA - Safety Intelligence Platform"
VERSION="1.1.0"
API_V1_STR="/api"

# Security — CHANGE THIS in any non-local environment
SECRET_KEY="astra-production-secret-change-me-cx1001"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────
# Development (default): zero-setup SQLite
DATABASE_URL="sqlite:///./astra.db"

# Production: PostgreSQL + PostGIS (uncomment and configure)
# DATABASE_URL="postgresql://astra_user:STRONG_PASSWORD@localhost:5432/astra_db"

# ── Demo Data Seeding ─────────────────────────────────────────────
# true  → Seeds synthetic demo incidents on startup (for local demo / evaluation)
# false → Production mode; no synthetic data injected
SEED_DEMO_DATA=true

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Restrict this to your actual deployment domain in production.
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5000,http://127.0.0.1:5000"

# ── Risk Engine Weights (must sum to 1.0) ─────────────────────────
WEIGHT_SPATIAL=0.20
WEIGHT_TEMPORAL=0.15
WEIGHT_FREQUENCY=0.15
WEIGHT_TREND=0.15
WEIGHT_DIVERSITY=0.20
WEIGHT_BEHAVIOUR=0.15

# ── Clustering ────────────────────────────────────────────────────
DBSCAN_EPS_KM=0.5
DBSCAN_MIN_SAMPLES=2

# ── Duplicate Detection ───────────────────────────────────────────
DUP_DISTANCE_THRESHOLD_KM=0.05
DUP_TIME_WINDOW_MINUTES=30

# ── Anti-Gaming ───────────────────────────────────────────────────
MAX_REPORTS_PER_USER_PER_HOUR=5

# ── Risk Level Thresholds ─────────────────────────────────────────
THRESHOLD_EMERGING=25.0
THRESHOLD_CONCERNING=50.0
THRESHOLD_ESCALATING=75.0
