FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_cv.txt .
RUN pip install --no-cache-dir -r requirements_cv.txt

COPY . .

EXPOSE 5000

CMD ["python", "complete.py"]
